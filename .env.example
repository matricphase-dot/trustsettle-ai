# TrustSettle AI — Production Environment
# Copy to .env and fill. NEVER commit .env to git.

NODE_ENV=production
PORT=3000
APP_URL=https://trustsettle-ai.example.com

# --- Auth ---
JWT_SECRET=change-me-to-32-char-random-secret
JWT_EXPIRES_IN=7d

# --- Database (Postgres) ---
# Leave DATABASE_URL empty for JSON-file fallback (hackathon/demo mode)
DATABASE_URL=postgres://user:password@localhost:5432/trustsettle

# --- PayPal (Sandbox for testing, Live for production) ---
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# --- AI ---
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=qwen/qwen3.8-27b
# XAI_API_KEY=your_xai_api_key
# XAI_MODEL=grok-3-mini
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_key

# --- Test accounts (sandbox only) ---
CLIENT_EMAIL=buyer@sandbox.example.com
FREELANCER_EMAIL=freelancer@sandbox.example.com

# --- Security ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
